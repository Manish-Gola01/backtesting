# Copy to .env and adjust. Never commit .env.
APP_NAME=Algo Backtesting Platform
APP_ENV=development
LOG_LEVEL=INFO
API_V1_PREFIX=/api/v1
# JSON array (parsed by pydantic-settings):
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
# Phase 3 — PostgreSQL:
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/backtesting
# Phase 2 — CSV upload cap (MB):
MAX_UPLOAD_MB=100
